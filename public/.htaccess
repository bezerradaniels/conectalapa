# ConectaLapa — Apache config for Hostinger shared hosting.
# Vite copies everything in public/ to dist/ untouched, so this file ships
# to the site root as-is.

# --- SPA fallback -----------------------------------------------------
# React Router owns client-side routing, so any URL that isn't a real file
# or directory on disk must still serve index.html and let the app render
# the right route. This also transparently serves the prerendered
# dist/empresas/<slug>/index.html (etc.) pages from scripts/postbuild.mjs
# with zero special-casing: Apache finds the real directory/file first and
# only falls through to index.html when nothing on disk matches.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Security headers ---------------------------------------------------
# HSTS is intentionally not set here — it belongs at Hostinger's SSL panel
# level (or Apache's global vhost config), not in a per-directory .htaccess,
# since a wrong HSTS header served over a broken cert can lock out visitors
# for the max-age duration with no way to undo it from this file alone.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Content-Security-Policy: allows Supabase (API + Storage) and Unsplash
  # (source images), inline styles/scripts (Vite emits a few small inline
  # bootstrap scripts and Tailwind's injected style tag needs 'unsafe-inline'
  # since this is a static build with no nonce mechanism available).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com https://*.supabase.co; connect-src 'self' https://*.supabase.co; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- Caching --------------------------------------------------------
# Content-hashed filenames (assets/*-<hash>.js) are safe to cache forever;
# index.html and the prerendered entry pages are not hashed and must always
# be revalidated so a new deploy is picked up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
